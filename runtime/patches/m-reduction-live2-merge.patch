+
+
+_ALIAS = None
+
+
+def alias_ids(layer_id, ids):
+    """P7 arm 2: map logical routed IDs to physical cluster representatives after native
+    top-k and effective weights (prefill and decode); identity when no merge is armed."""
+    global _ALIAS
+    path = os.getenv("FREETOKEN_M_REDUCTION_MERGE")
+    if not path:
+        return ids
+    if _ALIAS is None:
+        control = json.loads(Path(path).read_text())
+        layers = max(int(k) for k in control["usage"]) + 1
+        table = torch.arange(control["experts"], dtype=torch.int64).repeat(layers, 1)
+        for layer, mapping in control["alias"].items():
+            for logical, physical in mapping.items():
+                table[int(layer), int(logical)] = int(physical)
+        _ALIAS = table.to(ids.device)
+    return _ALIAS[layer_id][ids.long()].to(ids.dtype)
