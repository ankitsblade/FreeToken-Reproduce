+// Higher-precision diagnostic arm: identical BF16 boundaries, FP64 projections.
+void mxfp4_gemv_f64_scalar(float* out, const uint8_t* blk, const uint8_t* scl,
+                          const bf16_t* x, int Kpairs, int N2, int ncol,
+                          const float* e2m1, const float* e8m0) {
+  for (int c = 0; c < ncol; ++c) {
+    double acc = 0.0;
+    for (int kb = 0; kb < Kpairs; ++kb) {
+      const uint8_t w = blk[(size_t)kb * N2 + c];
+      const double scale = e8m0[scl[(size_t)(kb >> 4) * N2 + c]];
+      acc += (double)e2m1[w & 15] * scale * (double)bf16_to_f32(x[2 * kb]);
+      acc += (double)e2m1[w >> 4] * scale * (double)bf16_to_f32(x[2 * kb + 1]);
+    }
+    out[c] = static_cast<float>(acc);
+  }
+}
+#if CPU_MOE_X86
+__attribute__((target("avx512f,avx2")))
+void mxfp4_gemv_f64_avx512(float* out, const uint8_t* blk, const uint8_t* scl,
+                          const bf16_t* x, int Kpairs, int N2, int ncol,
+                          const float* e2m1, const float* e8m0) {
+  int c = 0;
+  for (; c + 8 <= ncol; c += 8) {
+    __m512d acc = _mm512_setzero_pd();
+    for (int kb = 0; kb < Kpairs; ++kb) {
+      __m256i packed = _mm256_cvtepu8_epi32(_mm_loadl_epi64(
+          reinterpret_cast<const __m128i*>(blk + (size_t)kb * N2 + c)));
+      __m256i lo = _mm256_and_si256(packed, _mm256_set1_epi32(15));
+      __m256i hi = _mm256_srli_epi32(packed, 4);
+      __m256i si = _mm256_cvtepu8_epi32(_mm_loadl_epi64(
+          reinterpret_cast<const __m128i*>(scl + (size_t)(kb >> 4) * N2 + c)));
+      __m512d scale = _mm512_cvtps_pd(_mm256_i32gather_ps(e8m0, si, 4));
+      __m512d wl = _mm512_mul_pd(_mm512_cvtps_pd(_mm256_i32gather_ps(e2m1, lo, 4)), scale);
+      __m512d wh = _mm512_mul_pd(_mm512_cvtps_pd(_mm256_i32gather_ps(e2m1, hi, 4)), scale);
+      acc = _mm512_fmadd_pd(wl, _mm512_set1_pd(bf16_to_f32(x[2 * kb])), acc);
+      acc = _mm512_fmadd_pd(wh, _mm512_set1_pd(bf16_to_f32(x[2 * kb + 1])), acc);
+    }
+    _mm256_storeu_ps(out + c, _mm512_cvtpd_ps(acc));
+  }
+  if (c < ncol)
+    mxfp4_gemv_f64_scalar(out + c, blk + c, scl + c, x, Kpairs, N2, ncol - c, e2m1, e8m0);
+}
