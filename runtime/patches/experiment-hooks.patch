+"""Opt-in full-request routing observation before expert IDs become cache slots."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import torch
+
+_ARM = os.getenv("FREETOKEN_MOE_ROUTING_ARM")
+_OBSERVER = None
+
+
+class RoutingObserver:
+    def __init__(self, arm_path: str):
+        self.arm_path = Path(arm_path)
+        self.capture_id = None
+        self.streams = {}
+        self.batch = None
+        self.chunk = {"prefill": 0, "decode": 0}
+        self.prompt_tokens = None
+        self.uid = None
+        self.pending_cache = None
+        self.cache_snapshot_written = False
+
+    def close(self):
+        for stream in self.streams.values():
+            stream.close()
+        self.streams = {}
+        self.batch = None
+
+    def emit(self, kind: str, row: dict):
+        self.streams[kind].write(json.dumps(row, allow_nan=False, separators=(",", ":")) + "\n")
+
+    def begin_batch(self, batch, cache):
+        self.batch = None
+        if not self.arm_path.exists():
+            self.close()
+            return
+        metadata = json.loads(self.arm_path.read_text())
+        if not metadata.get("armed"):
+            self.close()
+            return
+        if len(batch.reqs) != 1 or len(batch.padded_reqs) != 1:
+            raise RuntimeError("routing observation requires one unpadded request")
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("routing observation requires eager execution")
+        req = batch.reqs[0]
+        if req.uid < 0:
+            return
+        if metadata["capture_id"] != self.capture_id:
+            self.close()
+            self.capture_id = metadata["capture_id"]
+            self.metadata = metadata
+            if cache is None or cache.decode_target != "hybrid":
+                raise RuntimeError("routing study requires the qualified hybrid cache")
+            if metadata.get("require_pinned_banks"):
+                residency = list(cache.layer_residency)
+                if len(residency) != cache.num_layers or any(value != "pinned" for value in residency):
+                    raise RuntimeError("routing qualification requires pinned expert banks in every layer")
+            cache.reset()
+            target = Path(metadata["directory"])
+            target.mkdir(parents=True, exist_ok=True)
+            if metadata.get("require_pinned_banks") and metadata.get("observe", True):
+                (target / "expert_bank_residency.json").write_text(json.dumps({
+                    "layer_residency": residency, "quant_format": cache.quant_format,
+                    "semantics": "native cache residency labels from attached host banks"}) + "\n")
+            self.streams = ({kind: (target / (kind + ".jsonl.partial")).open("x")
+                             for kind in ("routes", "batches", "cache", "scores")}
+                            if metadata.get("observe", True) else {})
+            self.chunk = {"prefill": 0, "decode": 0}
+            self.prompt_tokens = metadata["prompt_tokens"]
+            self.uid = req.uid
+            self.cache_snapshot_written = False
+        if req.uid != self.uid:
+            raise RuntimeError("armed capture spans more than one scheduler request")
+        if not metadata.get("observe", True):
+            return
+        positions = batch.positions.cpu().tolist()
+        ids = batch.input_ids.cpu().tolist()
+        if len(positions) != len(ids):
+            raise RuntimeError("input IDs and scheduler positions disagree")
+        self.batch = {"capture_id": self.capture_id, "request_id": metadata["request_id"],
+                      "engine_uid": req.uid, "phase": batch.phase,
+                      "chunk_index": self.chunk[batch.phase], "input_positions": positions,
+                      "input_token_ids": ids, "prompt_tokens": self.prompt_tokens}
+        self.chunk[batch.phase] += 1
+        if batch.is_decode and not self.cache_snapshot_written:
+            if cache is None:
+                raise RuntimeError("native cache snapshot is unavailable")
+            state = {name: getattr(cache, name).cpu().tolist() for name in
+                     ("slot_for_id", "id_of_slot", "usage", "step", "expert_recency")}
+            state.update({"cache_slots": cache.cache_size, "experts": cache.num_experts,
+                          "layers": cache.num_layers, "fetch_fraction": cache.hybrid_fetch_fraction,
+                          "max_fetch": cache.hybrid_max_fetch, "policy": cache.cache_policy})
+            (Path(metadata["directory"]) / "decode_initial_cache.json").write_text(json.dumps(state) + "\n")
+            self.cache_snapshot_written = True
+
+    def observe(self, layer, weights, ids, cache):
+        if self.batch is None:
+            return
+        raw_ids = ids.cpu().tolist()
+        raw_weights = weights.cpu().tolist()
+        positions = self.batch["input_positions"]
+        if len(raw_ids) != len(positions) or len(raw_weights) != len(positions):
+            raise RuntimeError("routing rows do not match the native batch")
+        for index, position in enumerate(positions):
+            self.emit("routes", {"schema_version": 1, "capture_id": self.capture_id,
+                       "request_id": self.metadata["request_id"], "phase": self.batch["phase"],
+                       "chunk_index": self.batch["chunk_index"], "layer_id": layer.layer_id,
+                       "input_position": position, "input_token_id": self.batch["input_token_ids"][index],
+                       "phase_token_index": position if self.batch["phase"] == "prefill" else position - self.prompt_tokens,
+                       "expert_ids": raw_ids[index], "effective_weights": raw_weights[index],
+                       "selection_probability": None, "is_shared_expert": False,
+                       "weight_semantics": "native_effective_selected_weights", "E": layer.num_experts,
+                       "k": layer.top_k})
+        if self.batch["phase"] == "decode":
+            if cache is None or len(raw_ids) != 1:
+                raise RuntimeError("cache observation requires one offloaded decode token")
+            slots = cache.slot_for_id[layer.layer_id, raw_ids[0]].cpu().tolist()
+            self.pending_cache = {"layer_id": layer.layer_id, "raw_ids": raw_ids[0],
+                                  "slots_before": slots, "old_ids": cache.id_of_slot.clone()}
+
+    def observe_scores(self, layer_id: int, logits):
+        if self.batch is None or not self.metadata.get("full_scores"):
+            return
+        values = logits.float().cpu().tolist()
+        if len(values) != len(self.batch["input_positions"]):
+            raise RuntimeError("router logits do not match native positions")
+        for index, position in enumerate(self.batch["input_positions"]):
+            self.emit("scores", {"phase": self.batch["phase"], "layer_id": layer_id,
+                                "input_position": position, "scores": values[index],
+                                "semantics": "native_router_logits"})
+
+    def finish_cache(self, cache):
+        pending = self.pending_cache
+        if pending is None:
+            return
+        q = int(cache.num_indices.item())
+        slots = cache.evict_slots[:q].cpu().tolist()
+        sources = cache.src_indices[:q].cpu().tolist()
+        old_ids = pending["old_ids"][slots].cpu().tolist() if slots else []
+        missing = [e for e, s in zip(pending["raw_ids"], pending["slots_before"]) if s < 0]
+        if int(cache.num_missing_full.item()) != len(missing):
+            raise RuntimeError("observed cache miss count disagrees with native hybrid kernel")
+        self.emit("cache", {"capture_id": self.capture_id, "request_id": self.metadata["request_id"],
+                  "phase": "decode", "input_position": self.batch["input_positions"][0],
+                  "layer_id": pending["layer_id"], "raw_ids": pending["raw_ids"],
+                  "slots_before": pending["slots_before"], "missing_ids": missing,
+                  "m": len(missing), "q": q, "admitted_ids": sources,
+                  "evict_slots": slots, "evicted_flat_ids": old_ids,
+                  "step": int(cache.step.item()), "cache_slots": cache.cache_size,
+                  "cpu_executions": len(missing) - q})
+        self.pending_cache = None
+
+    def end_batch(self, next_tokens):
+        if self.batch is None:
+            return
+        if self.pending_cache is not None:
+            raise RuntimeError("cache observation was not completed")
+        self.emit("batches", {**self.batch, "sampled_token_ids": next_tokens.cpu().tolist()})
+        for stream in self.streams.values():
+            stream.flush()
+        self.batch = None
+
+
+def observer():
+    global _OBSERVER
+    if _ARM and _OBSERVER is None:
+        _OBSERVER = RoutingObserver(_ARM)
+    return _OBSERVER
+
+
+def observe_routes(layer, weights, ids, cache=None):
+    trace = observer()
+    if trace is not None:
+        trace.observe(layer, weights, ids, cache)
+
+
+def observe_scores(layer_id, logits):
+    trace = observer()
+    if trace is not None:
+        trace.observe_scores(layer_id, logits)
