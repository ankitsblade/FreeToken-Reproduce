diff --git a/python/freetoken/moe/decode_trace.py b/python/freetoken/moe/decode_trace.py
new file mode 100644
index 0000000..39588a3
--- /dev/null
+++ b/python/freetoken/moe/decode_trace.py
@@ -0,0 +1,155 @@
+"""Opt-in, eager-only MoE decode traffic log for bandwidth experiments."""
+
+from __future__ import annotations
+
+import csv
+import os
+import time
+from datetime import datetime, timezone
+
+import torch
+
+
+FIELDS = (
+    "timestamp", "run_id", "model_id", "request_id", "token_index", "layer_id",
+    "E", "k", "bank_count", "bank_bytes", "expert_size_bytes", "cache_slots", "cache_bytes",
+    "routed_experts", "unique_routed_count", "hit_count", "miss_count", "m",
+    "q_predicted", "q_forced", "gpu_fill_count", "cpu_execute_count",
+    "bytes_h2d", "cache_occupancy", "pcie_time_ms", "cpu_time_ms",
+    "gpu_time_ms", "layer_time_ms", "decode_tps",
+)
+
+
+class DecodeTrace:
+    def __init__(self, path: str, cache) -> None:
+        self.cache = cache
+        self.path = path
+        self.run_id = os.getenv("FREETOKEN_MOE_TRACE_RUN_ID", "")
+        self.model_id = os.getenv("FREETOKEN_MOE_TRACE_MODEL_ID", "")
+        self.steps = [0] * cache.num_layers
+        self.pending: dict | None = None
+        self.timing_enabled = os.getenv("FREETOKEN_MOE_LAYER_TIMING") == "1"
+        self.layer_started_at: float | None = None
+        self.q_switch_file = os.getenv("FREETOKEN_MOE_Q_SWITCH_FILE")
+        self.measure_q = (int(os.environ["FREETOKEN_MOE_MEASURE_Q"])
+                          if self.q_switch_file else None)
+        self.q_switched = False
+
+    def start_layer(self) -> None:
+        if self.q_switch_file and not self.q_switched and os.path.exists(self.q_switch_file):
+            self.cache.hybrid_max_fetch = self.measure_q
+            self.q_switched = True
+        if self.timing_enabled:
+            self.layer_started_at = time.perf_counter()
+
+    def begin(self, layer_id: int, expert_ids: torch.Tensor) -> None:
+        if expert_ids.is_cuda and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("FREETOKEN_MOE_DECODE_TRACE_CSV requires eager decode (--no-graph)")
+        if self.pending is not None:
+            raise RuntimeError("previous MoE decode trace row was not completed")
+        if self.timing_enabled:
+            self.pending = {
+                "timestamp": datetime.now(timezone.utc).isoformat(),
+                "run_id": self.run_id,
+                "model_id": self.model_id,
+                "request_id": "",
+                "token_index": self.steps[layer_id],
+                "layer_id": layer_id,
+                "E": self.cache.num_experts,
+                "k": expert_ids.shape[-1],
+                "_ids": expert_ids.reshape(-1).clone(),
+                "_slots": self.cache.slot_for_id[layer_id].clone(),
+            }
+            return
+        ids = expert_ids.reshape(-1).tolist()
+        unique = sorted(set(ids))
+        resident = self.cache.slot_for_id[layer_id, unique].tolist()
+        hits = sum(slot >= 0 for slot in resident)
+        self.pending = {
+            "timestamp": datetime.now(timezone.utc).isoformat(),
+            "run_id": self.run_id,
+            "model_id": self.model_id,
+            "request_id": "",
+            "token_index": self.steps[layer_id],
+            "layer_id": layer_id,
+            "E": self.cache.num_experts,
+            "k": expert_ids.shape[-1],
+            "routed_experts": ";".join(map(str, ids)),
+            "unique_routed_count": len(unique),
+            "hit_count": hits,
+            "miss_count": len(unique) - hits,
+            "m": len(unique) - hits,
+        }
+
+    def finish(self) -> None:
+        if self.pending is None or self.timing_enabled:
+            return
+        self._populate_pending()
+        self._write_pending()
+
+    def _populate_pending(self) -> None:
+        row = self.pending
+        assert row is not None
+        if "_ids" in row:
+            ids = row.pop("_ids").tolist()
+            slots = row.pop("_slots")
+            unique = sorted(set(ids))
+            hits = sum(int(slot) >= 0 for slot in slots[unique].tolist())
+            row.update({
+                "routed_experts": ";".join(map(str, ids)),
+                "unique_routed_count": len(unique),
+                "hit_count": hits,
+                "miss_count": len(unique) - hits,
+                "m": len(unique) - hits,
+            })
+        cache = self.cache
+        layer_id = row["layer_id"]
+        fetched = int(cache.num_indices.item())
+        missing = row["miss_count"]
+        if cache.decode_target == "hybrid":
+            actual_missing = int(cache.num_missing_full.item())
+            if actual_missing != missing:
+                raise RuntimeError(f"MoE trace miss mismatch: {missing} vs {actual_missing}")
+        bank_bytes = [
+            source[layer_id][0].numel() * source[layer_id].element_size()
+            for source, _ in cache.banks
+        ]
+        expert_size_bytes = sum(bank_bytes)
+        row.update({
+            "bank_count": len(bank_bytes),
+            "bank_bytes": ";".join(map(str, bank_bytes)),
+            "expert_size_bytes": expert_size_bytes,
+            "cache_slots": cache.cache_size,
+            "cache_bytes": cache.cache_size * expert_size_bytes,
+            "q_predicted": fetched if cache.decode_target == "hybrid" and cache.hybrid_fetch_fraction > 0 else "",
+            "q_forced": cache.hybrid_max_fetch if cache.decode_target == "hybrid" and cache.hybrid_fetch_fraction <= 0 else "",
+            "gpu_fill_count": fetched,
+            "cpu_execute_count": missing - fetched,
+            "bytes_h2d": fetched * expert_size_bytes,
+            "cache_occupancy": int((cache.id_of_slot >= 0).sum().item()),
+        })
+
+    def finish_layer(self) -> None:
+        if not self.timing_enabled:
+            return
+        if self.layer_started_at is None or self.pending is None:
+            raise RuntimeError("MoE layer timer was not started or trace row was not prepared")
+        torch.cuda.synchronize(self.cache.device)
+        elapsed_ms = (time.perf_counter() - self.layer_started_at) * 1000
+        self.layer_started_at = None
+        self._populate_pending()
+        self.pending["layer_time_ms"] = elapsed_ms
+        self._write_pending()
+
+    def _write_pending(self) -> None:
+        row = self.pending
+        assert row is not None
+        os.makedirs(os.path.dirname(os.path.abspath(self.path)), exist_ok=True)
+        needs_header = not os.path.exists(self.path) or os.path.getsize(self.path) == 0
+        with open(self.path, "a", newline="") as output:
+            writer = csv.DictWriter(output, fieldnames=FIELDS)
+            if needs_header:
+                writer.writeheader()
+            writer.writerow(row)
+        self.steps[row["layer_id"]] += 1
+        self.pending = None
diff --git a/python/freetoken/moe/layer_replay.py b/python/freetoken/moe/layer_replay.py
new file mode 100644
index 0000000..be2c181
--- /dev/null
+++ b/python/freetoken/moe/layer_replay.py
@@ -0,0 +1,283 @@
+"""Opt-in, same-state replay of one real hybrid decode layer."""
+
+from __future__ import annotations
+
+import csv
+import json
+import math
+import os
+import random
+import statistics
+import time
+from contextlib import nullcontext
+from pathlib import Path
+
+import torch
+
+
+STATE_TENSORS = (
+    "slot_for_id", "id_of_slot", "usage", "step", "expert_recency",
+    "active_mask", "evict_slots", "src_indices", "num_indices",
+    "num_missing_full",
+)
+
+
+class CacheSnapshot:
+    def __init__(self, cache) -> None:
+        self.tensors = {name: getattr(cache, name).clone() for name in STATE_TENSORS}
+        self.pending_src_layer = cache._pending_src_layer
+        self.pending_whole_layer = cache._pending_whole_layer
+
+    def restore(self, cache) -> None:
+        for name, value in self.tensors.items():
+            getattr(cache, name).copy_(value)
+        cache._pending_src_layer = self.pending_src_layer
+        cache._pending_whole_layer = self.pending_whole_layer
+
+    def matches(self, cache) -> bool:
+        return all(torch.equal(getattr(cache, name), value)
+                   for name, value in self.tensors.items())
+
+
+class SlotBackup:
+    def __init__(self) -> None:
+        self.slots = None
+        self.values = []
+
+    def capture(self, cache) -> None:
+        if self.slots is not None:
+            raise RuntimeError("previous replay slot backup was not restored")
+        count = int(cache.num_indices.item())
+        self.slots = cache.evict_slots[:count].long().clone()
+        self.values = [bank.index_select(0, self.slots) for _, bank in cache.banks]
+
+    def restore(self, cache) -> None:
+        if self.slots is None:
+            return
+        for (_, bank), values in zip(cache.banks, self.values):
+            bank.view(torch.uint8).index_copy_(0, self.slots, values.view(torch.uint8))
+        self.slots = None
+        self.values = []
+
+
+def _events() -> dict[str, torch.cuda.Event]:
+    return {name: torch.cuda.Event(enable_timing=True)
+            for name in ("pcie_start", "pcie_end", "gpu_start", "gpu_end")}
+
+
+def predicted_q(m: int, fraction: float) -> int:
+    frac = min(1 << 16, max(0, round(fraction * (1 << 16))))
+    lo = (m * frac) >> 16
+    cost = lambda q: max(q * ((1 << 16) - frac), (m - q) * frac)
+    return min(m, lo if cost(lo) <= cost(lo + 1) else lo + 1)
+
+
+def cpu_branch_metrics(elapsed_ms: float, experts: int, expert_bytes: int) -> dict:
+    if not math.isfinite(elapsed_ms) or elapsed_ms <= 0 or experts < 0 or expert_bytes <= 0:
+        raise ValueError("CPU timing must be positive with valid expert counts and bytes")
+    return {"cpu_task_ms": elapsed_ms,
+            "cpu_effective_gbps": experts * expert_bytes / (elapsed_ms * 1e6)}
+
+
+def _write_csv(path: Path, rows: list[dict]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def run(layer, cache, hidden_states: torch.Tensor, topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor, path: Path, *, misses: int, repeats: int,
+        warmup: int, seed: int = 42, match_index: int = 0) -> None:
+    if path.exists():
+        raise FileExistsError(path)
+    if cache.collect_stats or cache.collect_decode_freq:
+        raise RuntimeError("layer replay requires MoE stats and decode-frequency collection disabled")
+    if repeats < 2 or warmup < 0:
+        raise ValueError("repeats must be >=2 and warmup >=0")
+    if hidden_states.shape[0] != 1:
+        raise RuntimeError("layer replay requires batch size 1")
+    ids = topk_ids.reshape(-1).tolist()
+    unique = sorted(set(ids))
+    actual_m = sum(int(cache.slot_for_id[layer.layer_id, expert]) < 0 for expert in unique)
+    if actual_m != misses:
+        raise ValueError(f"expected {misses} misses, got {actual_m}")
+
+    torch.cuda.synchronize(cache.device)
+    snapshot = CacheSnapshot(cache)
+    old_trace = cache.decode_trace
+    trace_step = (old_trace.steps[layer.layer_id] if old_trace is not None else None)
+    old_q = cache.hybrid_max_fetch
+    old_fraction = cache.hybrid_fetch_fraction
+    if old_fraction <= 0:
+        raise RuntimeError("layer replay needs the calibrated automatic hybrid fraction")
+    backup = SlotBackup()
+    profile_path = os.getenv("FREETOKEN_MOE_LAYER_REPLAY_PROFILE_OUT")
+    cpu_timing = os.getenv("FREETOKEN_MOE_LAYER_REPLAY_CPU_TIMING") == "1"
+    executor = cache.cpu_executor
+    cpu_task = None
+    if cpu_timing:
+        if not hasattr(executor._ext, "set_task_timing"):
+            raise RuntimeError("CPU replay timing requires rebuilding the native extension")
+        cpu_task = executor._task_for(layer.layer_id, hidden_states.shape[0])
+    profiler = (torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CPU,
+                                                    torch.profiler.ProfilerActivity.CUDA])
+                if profile_path else None)
+    cache._layer_replay_active = True
+    cache.decode_trace = None
+    reference = None
+    raw = []
+
+    def trial(q: int, repeat: int) -> None:
+        nonlocal reference
+        snapshot.restore(cache)
+        if not snapshot.matches(cache):
+            raise RuntimeError("cache bookkeeping did not restore exactly")
+        cache.hybrid_max_fetch = q
+        cache.hybrid_fetch_fraction = 0.0
+        cache.ensure_experts_hybrid(layer.layer_id, topk_ids.clone())
+        if int(cache.num_missing_full.item()) != misses or int(cache.num_indices.item()) != q:
+            raise RuntimeError("preflight did not produce the requested miss/fill count")
+        backup.capture(cache)
+        snapshot.restore(cache)
+        x = hidden_states.clone()
+        weights = topk_weights.clone()
+        routed = topk_ids.clone()
+        events = _events()
+        cache._layer_replay_events = events
+        torch.cuda.synchronize(cache.device)
+        torch.cuda.nvtx.range_push(f"moe_replay_layer_{layer.layer_id}_m{misses}_q{q}")
+        start = time.perf_counter()
+        try:
+            record = (torch.profiler.record_function(f"moe_replay_q{q}")
+                      if profiler is not None else nullcontext())
+            with record:
+                output = layer._decode_hybrid(cache, x, weights, routed)
+                torch.cuda.synchronize(cache.device)
+        finally:
+            torch.cuda.nvtx.range_pop()
+        elapsed = 1000 * (time.perf_counter() - start)
+        seen_m = int(cache.num_missing_full.item())
+        seen_q = int(cache.num_indices.item())
+        if seen_m != misses or seen_q != q:
+            raise RuntimeError(f"replay changed miss/fill count: {(seen_m, seen_q)} != {(misses, q)}")
+        if not torch.equal(cache.evict_slots[:seen_q].long(), backup.slots):
+            raise RuntimeError("replay changed eviction slots after preflight")
+        if q == 0 and reference is None:
+            reference = output.detach().clone()
+        max_abs_diff = (output.detach() - reference).abs().max().item() if reference is not None else None
+        if repeat >= 0:
+            expert_bytes = sum(source[layer.layer_id][0].numel() *
+                               source[layer.layer_id][0].element_size()
+                               for source, _ in cache.banks)
+            raw.append({
+                "layer_id": layer.layer_id, "m": misses, "q": q,
+                "repeat": repeat, "seed": seed, "routed_experts": ";".join(map(str, ids)),
+                "cache_slots": cache.cache_size, "expert_bytes": expert_bytes,
+                "actual_m": seen_m, "actual_q": seen_q,
+                "layer_wall_ms": elapsed,
+                "pcie_device_ms": events["pcie_start"].elapsed_time(events["pcie_end"]),
+                "gpu_gemm_device_ms": events["gpu_start"].elapsed_time(events["gpu_end"]),
+                "max_abs_output_diff_vs_q0": max_abs_diff,
+                "scope": "production_layer_fixed_input_and_cache",
+            })
+            if cpu_timing:
+                raw[-1].update(cpu_branch_metrics(
+                    executor._ext.task_timing_ms(cpu_task), misses - q, expert_bytes))
+        backup.restore(cache)
+
+    if profiler is not None:
+        profiler.start()
+    torch.cuda.nvtx.range_push("moe_replay_sweep")
+    try:
+        if cpu_timing:
+            executor._ext.set_task_timing(cpu_task, True)
+        trial(0, -1)
+        rng = random.Random(seed)
+        for repeat in range(-warmup, repeats):
+            order = list(range(misses + 1))
+            rng.shuffle(order)
+            for q in order:
+                trial(q, repeat)
+        snapshot.restore(cache)
+        torch.cuda.synchronize(cache.device)
+        if not snapshot.matches(cache):
+            raise RuntimeError("cache bookkeeping changed after replay")
+    finally:
+        if cpu_timing:
+            torch.cuda.synchronize(cache.device)
+            executor._ext.set_task_timing(cpu_task, False)
+        torch.cuda.nvtx.range_pop()
+        backup.restore(cache)
+        snapshot.restore(cache)
+        cache.decode_trace = old_trace
+        cache.hybrid_max_fetch = old_q
+        cache.hybrid_fetch_fraction = old_fraction
+        cache._layer_replay_active = False
+        cache._layer_replay_events = None
+        if profiler is not None:
+            profiler.stop()
+
+    if profiler is not None:
+        profile_target = Path(profile_path)
+        profile_target.parent.mkdir(parents=True, exist_ok=True)
+        profiler.export_chrome_trace(str(profile_target))
+
+    _write_csv(path, raw)
+    medians = {q: statistics.median(row["layer_wall_ms"] for row in raw if row["q"] == q)
+               for q in range(misses + 1)}
+    oracle = min(medians, key=medians.get)
+    profile_fraction = old_fraction
+    predicted = predicted_q(misses, profile_fraction)
+    summary = [{
+        "layer_id": layer.layer_id, "m": misses, "q": q, "n": repeats,
+        "median_layer_wall_ms": medians[q], "q_predicted": predicted,
+        "q_oracle": oracle, "q_error": predicted - oracle,
+        "latency_penalty_predicted": medians[predicted] / medians[oracle] - 1,
+        "max_abs_output_diff_vs_q0": max(row["max_abs_output_diff_vs_q0"]
+                                         for row in raw if row["q"] == q),
+        "scope": "production_layer_fixed_input_and_cache",
+    } for q in range(misses + 1)]
+    _write_csv(path.with_name(path.stem + "_summary.csv"), summary)
+    path.with_name(path.stem + "_config.json").write_text(json.dumps({
+        "layer_id": layer.layer_id, "m": misses, "repeats": repeats,
+        "warmup": warmup, "seed": seed, "routed_experts": ids,
+        "match_index": match_index, "trace_step": trace_step,
+        "cache_slots": cache.cache_size, "expert_bytes": raw[0]["expert_bytes"],
+        "fraction": profile_fraction, "q_predicted": predicted,
+        "cpu_timing": cpu_timing,
+        "cpu_timing_scope": ("native submit preparation, worker dispatch, and compute; "
+                             "excludes D2H, coordinator wait, and output H2D"
+                             if cpu_timing else None),
+        "caveat": "One real layer input and cache snapshot; not whole-model decode throughput",
+    }, indent=2) + "\n")
+
+
+def maybe_run(layer, cache, hidden_states: torch.Tensor,
+              topk_weights: torch.Tensor, topk_ids: torch.Tensor) -> None:
+    path = os.getenv("FREETOKEN_MOE_LAYER_REPLAY_OUT")
+    arm_file = os.getenv("FREETOKEN_MOE_LAYER_REPLAY_ARM_FILE")
+    if (not path or not arm_file or not os.path.exists(arm_file) or
+            getattr(cache, "_layer_replay_active", False) or
+            getattr(cache, "_layer_replay_done", False)):
+        return
+    selected_layer = os.getenv("FREETOKEN_MOE_LAYER_REPLAY_LAYER")
+    if selected_layer is not None and layer.layer_id != int(selected_layer):
+        return
+    misses = int(os.getenv("FREETOKEN_MOE_LAYER_REPLAY_M", "4"))
+    unique = topk_ids.reshape(-1).unique()
+    count = int((cache.slot_for_id[layer.layer_id, unique.long()] < 0).sum().item())
+    if count != misses:
+        return
+    match_index = getattr(cache, "_layer_replay_match_count", 0)
+    cache._layer_replay_match_count = match_index + 1
+    if match_index < int(os.getenv("FREETOKEN_MOE_LAYER_REPLAY_SKIP_MATCHES", "0")):
+        return
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("layer replay requires eager decode")
+    cache._layer_replay_done = True
+    run(layer, cache, hidden_states, topk_weights, topk_ids, Path(path), misses=misses,
+        repeats=int(os.getenv("FREETOKEN_MOE_LAYER_REPLAY_REPEATS", "40")),
+        warmup=int(os.getenv("FREETOKEN_MOE_LAYER_REPLAY_WARMUP", "3")),
+        match_index=match_index)
