+// Opt-in NVFP4 precision arm: exact packed weights, FP64 accumulation.
+float dot_nvfp4_f64_scalar(const uint8_t* packed, const uint8_t* scale, float global,
+                           const float* xe, const float* xo, int K,
+                           const float* e2m1, const float* e4m3) {
+  double acc = 0.0;
+  for (int b = 0; b < K / 16; ++b) {
+    const double s = e4m3[scale[b]];
+    for (int j = 0; j < 8; ++j) {
+      const uint8_t byte = packed[(size_t)b * 8 + j];
+      acc += (double)e2m1[byte & 15] * s * (double)xe[(size_t)b * 8 + j];
+      acc += (double)e2m1[byte >> 4] * s * (double)xo[(size_t)b * 8 + j];
+    }
+  }
+  return static_cast<float>(acc * (double)global);
+}
+#if CPU_MOE_X86
+__attribute__((target("avx512f,avx2")))
+float dot_nvfp4_f64_avx512(const uint8_t* packed, const uint8_t* scale, float global,
+                           const float* xe, const float* xo, int K,
+                           const float* e2m1, const float* e4m3) {
+  __m512d even = _mm512_setzero_pd(), odd = _mm512_setzero_pd();
+  for (int b = 0; b < K / 16; ++b) {
+    __m256i byte = _mm256_cvtepu8_epi32(_mm_loadl_epi64(
+        reinterpret_cast<const __m128i*>(packed + (size_t)b * 8)));
+    __m256 low = _mm256_i32gather_ps(e2m1, _mm256_and_si256(byte, _mm256_set1_epi32(15)), 4);
+    __m256 high = _mm256_i32gather_ps(e2m1, _mm256_srli_epi32(byte, 4), 4);
+    __m512d s = _mm512_set1_pd(e4m3[scale[b]]);
+    even = _mm512_fmadd_pd(_mm512_mul_pd(_mm512_cvtps_pd(low), s),
+                          _mm512_cvtps_pd(_mm256_loadu_ps(xe + (size_t)b * 8)), even);
+    odd = _mm512_fmadd_pd(_mm512_mul_pd(_mm512_cvtps_pd(high), s),
+                         _mm512_cvtps_pd(_mm256_loadu_ps(xo + (size_t)b * 8)), odd);
+  }
+  return static_cast<float>(_mm512_reduce_add_pd(_mm512_add_pd(even, odd)) * (double)global);
+}
+#endif
+
+inline float nvfp4_precise_activation(int act, float gate) {
+  if (act == ACT_SILU) {
+    const float exponential = static_cast<float>(std::exp((double)-gate));
+    return gate / (1.0f + exponential);
+  }
+  if (act == ACT_GELU_TANH) {
+    const float inner = 0.79788456080286535588f * (gate + 0.044715f * gate * gate * gate);
+    const float t = static_cast<float>(std::tanh((double)inner));
+    return (0.5f * gate) * (1.0f + t);
+  }
+  throw std::runtime_error("NVFP4 precision arm supports silu/gelu_tanh only");
+}
