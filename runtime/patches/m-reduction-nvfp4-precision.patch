+"""Opt-in common CPU/GPU activation arithmetic for NVFP4 qualification."""
+import triton
+import triton.language as tl
+from triton.language.extra.cuda import libdevice
+
+
+@triton.jit
+def _activation(x, out, I: tl.constexpr, IN_STRIDE: tl.constexpr, OUT_STRIDE: tl.constexpr,
+                KIND: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    offset = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    gate = tl.load(x + row * IN_STRIDE + offset, mask=offset < I, other=0).to(tl.float32)
+    up = tl.load(x + row * IN_STRIDE + I + offset, mask=offset < I, other=0).to(tl.float32)
+    if KIND == 0:
+        e = libdevice.exp((-gate).to(tl.float64)).to(tl.float32)
+        activated = libdevice.div_rn(gate, 1.0 + e)
+    else:
+        inner = 0.79788456080286535588 * (gate + 0.044715 * gate * gate * gate)
+        t = libdevice.tanh(inner.to(tl.float64)).to(tl.float32)
+        activated = (0.5 * gate) * (1.0 + t)
+    tl.store(out + row * OUT_STRIDE + offset, activated * up, mask=offset < I)
+
+
+def precise_gated_activation(x, out, activation):
+    kind = {"silu": 0, "gelu_tanh": 2}[activation]
+    _activation[(out.shape[0], triton.cdiv(out.shape[1], 128))](
+        x, out, out.shape[1], x.stride(0), out.stride(0), KIND=kind, BLOCK=128,
+        enable_fp_fusion=False, num_warps=4)
